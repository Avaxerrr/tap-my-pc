<?xml version="1.0" encoding="utf-8"?>
<Window
  x:Class="TapMyPC.Desktop.Features.Feedback.FeedbackWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="TapMyPC feedback"
  Width="370"
  SizeToContent="Height"
  WindowStyle="None"
  ResizeMode="NoResize"
  AllowsTransparency="True"
  Background="Transparent"
  Foreground="#EEF3EE"
  ShowInTaskbar="False"
  ShowActivated="False"
  Topmost="True"
  Focusable="False">
  <Border
    Background="#F21B2526"
    BorderBrush="#4A6152"
    BorderThickness="1"
    CornerRadius="18"
    Padding="22">
    <StackPanel>
      <TextBlock
        Text="TAPMYPC"
        Foreground="#B8DCA0"
        FontSize="10"
        FontWeight="SemiBold"
        Margin="0,0,0,12" />
      <TextBlock
        x:Name="Heading"
        FontSize="23"
        FontWeight="SemiBold"
        TextWrapping="Wrap" />
      <TextBlock
        x:Name="Detail"
        Foreground="#BDCBC5"
        FontSize="13"
        TextWrapping="Wrap"
        Margin="0,8,0,0" />
      <ProgressBar
        x:Name="AudioBar"
        Minimum="0"
        Maximum="100"
        Height="5"
        Foreground="#C9EFAA"
        Background="#3D4A45"
        BorderThickness="0"
        Margin="0,16,0,0"
        Visibility="Collapsed" />
      <TextBlock
        x:Name="Countdown"
        Foreground="#C9EFAA"
        FontSize="28"
        FontWeight="Light"
        Margin="0,12,0,0"
        Visibility="Collapsed" />
      <Button
        x:Name="CancelButton"
        Content="Cancel power action"
        Click="Cancel_Click"
        Focusable="False"
        Background="#C9EFAA"
        Foreground="#182317"
        BorderThickness="0"
        Padding="12,9"
        HorizontalAlignment="Left"
        Margin="0,12,0,0"
        Visibility="Collapsed" />
    </StackPanel>
  </Border>
</Window>