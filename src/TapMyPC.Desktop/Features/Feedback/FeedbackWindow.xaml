<Window x:Class="TapMyPC.Desktop.Features.Feedback.FeedbackWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="TapMyPC feedback" Width="360" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
 AllowsTransparency="True" Background="Transparent" Foreground="#F5F5F7"
 FontFamily="pack://application:,,,/TapMyPC;component/Assets/Fonts/#Inter 18pt 18pt"
 TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale" UseLayoutRounding="True"
 ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False">
  <Window.Resources>
    <SolidColorBrush x:Key="AccentBlue" Color="#0875DF"/>
    <SolidColorBrush x:Key="AccentBlueHover" Color="#0969C6"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#122338"/>
    <SolidColorBrush x:Key="AccentBorder" Color="#25466A"/>
    <SolidColorBrush x:Key="AccentText" Color="#8EC6FF"/>
    <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ErrorText" Color="#FFB4AB"/>
    <SolidColorBrush x:Key="ErrorSoft" Color="#342124"/>
    <SolidColorBrush x:Key="ErrorBorder" Color="#694047"/>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  </Window.Resources>
  <Border x:Name="FeedbackCard" Background="#16181D" BorderBrush="#343946" BorderThickness="1" CornerRadius="10" Padding="16">
    <StackPanel>
      <Grid Margin="0,0,0,12">
        <TextBlock Text="TAPMYPC" FontSize="10" FontWeight="SemiBold" Foreground="#98989D"/>
        <TextBlock x:Name="PhaseLabel" FontSize="10" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Right"/>
      </Grid>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="IconBackground" Background="{DynamicResource AccentSoft}" CornerRadius="8" Width="36" Height="36" VerticalAlignment="Top">
          <TextBlock x:Name="ActionIcon" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AccentText}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Action status"/>
        </Border>
        <StackPanel Grid.Column="2">
          <TextBlock x:Name="Heading" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBlock x:Name="Detail" FontSize="12" Foreground="#B6BBC5" LineHeight="17"/>
        </StackPanel>
      </Grid>
      <Grid x:Name="CountdownRow" Margin="0,16,0,0" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="STARTS IN" FontSize="9.5" Foreground="#98989D" Margin="0,0,0,3"/>
          <TextBlock x:Name="Countdown" Foreground="{DynamicResource AccentText}" FontSize="22" FontWeight="SemiBold"/>
        </StackPanel>
        <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel action" Click="Cancel_Click" Focusable="False"
                VerticalAlignment="Center" Foreground="{DynamicResource AccentForeground}" Background="{DynamicResource AccentBlue}"
                Padding="14,9" FontSize="12" FontWeight="SemiBold" Cursor="Hand" AutomationProperties.Name="Cancel power action">
          <Button.Template><ControlTemplate TargetType="Button">
            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource AccentBlueHover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.8"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate></Button.Template>
        </Button>
      </Grid>
      <ProgressBar x:Name="CountdownBar" Minimum="0" Maximum="10" Height="3" Foreground="{DynamicResource AccentBlue}"
                   Background="#262A34" Margin="0,12,0,0" Visibility="Collapsed">
        <ProgressBar.Template><ControlTemplate TargetType="ProgressBar">
          <Grid x:Name="PART_Track" Background="{TemplateBinding Background}">
            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="1"/>
          </Grid>
        </ControlTemplate></ProgressBar.Template>
      </ProgressBar>
    </StackPanel>
  </Border>
</Window>
