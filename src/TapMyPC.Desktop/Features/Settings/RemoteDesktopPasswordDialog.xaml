<Window x:Class="TapMyPC.Desktop.Features.Settings.RemoteDesktopPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote Desktop password" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimary}" Foreground="{DynamicResource TextPrimary}" FontSize="13">
  <StackPanel Margin="22">
    <StackPanel x:Name="ChoosePanel">
      <TextBlock Text="Choose a viewer password" FontSize="18" FontWeight="SemiBold" />
      <Grid Margin="0,18,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Viewer password" FontWeight="Medium" />
        <TextBlock Grid.Column="1">
          <Hyperlink Click="Generate_Click" Foreground="{DynamicResource AccentText}">Generate password</Hyperlink>
        </TextBlock>
      </Grid>
      <Grid>
        <PasswordBox x:Name="CustomPassword" AutomationProperties.Name="Viewer password" Padding="8,6"
                     Background="{DynamicResource SurfaceCard}" Foreground="{DynamicResource TextPrimary}"
                     BorderBrush="{DynamicResource BorderHairline}" PasswordChanged="PasswordInput_Changed" />
        <TextBox x:Name="VisiblePassword" AutomationProperties.Name="Viewer password" Padding="8,6"
                 Visibility="Collapsed" IsUndoEnabled="False" TextChanged="PasswordInput_Changed" />
      </Grid>
      <CheckBox x:Name="ShowPassword" Content="Show password" Foreground="{DynamicResource TextPrimary}"
                Click="ShowPassword_Click" Margin="0,10,0,0" />
      <TextBlock Text="Use 1–8 characters. English letters, numbers, and standard symbols are supported."
                 TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0" />
      <TextBlock x:Name="ValidationFeedback" TextWrapping="Wrap" Foreground="{DynamicResource AccentText}" Margin="0,4,0,0" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button Content="Cancel" IsCancel="True" MinWidth="82" Margin="0,0,8,0" />
        <Button x:Name="Confirm" Content="Continue" Click="Confirm_Click" IsDefault="True" IsEnabled="False"
                MinWidth="106" Background="{DynamicResource AccentBlue}" Foreground="{DynamicResource AccentForeground}" />
      </StackPanel>
    </StackPanel>
    <StackPanel x:Name="GeneratedPanel" Visibility="Collapsed">
      <TextBlock Text="Your viewer password" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Text="Enter it on your phone and select Remember for this PC."
                 TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,12" />
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Copy" Click="Copy_Click" Margin="8,0,0,0" />
        <TextBox x:Name="GeneratedPassword" IsReadOnly="True" FontFamily="Consolas" FontSize="17"
                 AutomationProperties.Name="Generated viewer password" />
      </DockPanel>
      <TextBlock x:Name="CopyFeedback" TextWrapping="Wrap" Foreground="{DynamicResource AccentText}" Margin="0,6,0,0" />
      <Button Content="Done" Click="Done_Click" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" Margin="0,12,0,0" />
    </StackPanel>
  </StackPanel>
</Window>
