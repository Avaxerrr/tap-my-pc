<Window x:Class="TapMyPC.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:devices="clr-namespace:TapMyPC.Core.Devices;assembly=TapMyPC.Core"
 xmlns:presentation="clr-namespace:TapMyPC.Desktop.Presentation"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="TapMyPC" Icon="Assets/TapMyPC.ico" Width="680" Height="640" MinWidth="640" MinHeight="560"
 WindowStyle="None" WindowStartupLocation="CenterScreen" Background="{DynamicResource BgPrimary}" Foreground="{DynamicResource TextPrimary}"
 FontFamily="./Assets/Fonts/#Inter 18pt 18pt" FontSize="13"
 TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True"
 PreviewKeyDown="Window_PreviewKeyDown" DataContextChanged="Window_DataContextChanged">
<shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="52"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="16"
                      UseAeroCaptionButtons="False" />
</shell:WindowChrome.WindowChrome>

<Window.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility" />
  <presentation:ListViewportHeight x:Key="ListViewportHeight"/>
  <Style x:Key="KeyboardFocus" TargetType="Control">
    <Setter Property="Template"><Setter.Value><ControlTemplate>
      <Border BorderBrush="{DynamicResource AccentText}" BorderThickness="2" CornerRadius="6" Margin="-3" />
    </ControlTemplate></Setter.Value></Setter>
  </Style>


  <!-- Default TextBlock -->
  <Style TargetType="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style x:Key="ConnectionBadge" TargetType="ContentControl">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="{DynamicResource SurfaceElevated}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderHairline}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="6" Padding="10,4">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="6" Height="6" Margin="0,0,7,0" Fill="{TemplateBinding Foreground}" />
              <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                         Foreground="{TemplateBinding Foreground}" FontSize="11" FontWeight="SemiBold" />
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TransportBadge" TargetType="ContentControl" BasedOn="{StaticResource ConnectionBadge}">
    <Setter Property="Content" Value="Connected" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Transport}" Value="{x:Static devices:RemoteTransport.Bluetooth}">
        <Setter Property="Content" Value="Bluetooth" />
        <Setter Property="Background" Value="{DynamicResource BluetoothBadgeFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BluetoothBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource BluetoothText}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Transport}" Value="{x:Static devices:RemoteTransport.WiFi}">
        <Setter Property="Content" Value="Wi-Fi" />
        <Setter Property="Background" Value="{DynamicResource WiFiBadgeFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WiFiBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource WiFiText}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Transport}" Value="{x:Static devices:RemoteTransport.Tailscale}">
        <Setter Property="Content" Value="Tailscale" />
        <Setter Property="Background" Value="{DynamicResource TailscaleBadgeFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TailscaleBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource TailscaleText}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
    <Setter Property="Width" Value="12"/><Setter Property="MinWidth" Value="12"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
      <Grid Background="Transparent">
        <Track x:Name="PART_Track" IsDirectionReversed="True">
          <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb MinHeight="28" Cursor="Hand">
            <Thumb.Template><ControlTemplate TargetType="Thumb">
              <Border x:Name="Grip" Background="{DynamicResource ScrollThumb}" CornerRadius="2" Margin="3,0"/>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource TextMuted}"/></Trigger>
                <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource AccentBlue}"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></Thumb.Template>
          </Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
        </Track>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Secondary Pill/Rounded Button -->
  <Style TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceSubtle}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Surface"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="6"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Surface" Property="Opacity" Value="0.38" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Apple System Blue Primary Button -->
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource AccentBlue}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentForeground}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Surface"
                  Background="{TemplateBinding Background}"
                  CornerRadius="6"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentBlueHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Surface" Property="Opacity" Value="0.38" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Apple iOS / macOS Style Toggle Switch (Replaces old CheckBoxes) -->
  <Style x:Key="AppleToggleSwitch" TargetType="CheckBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Border x:Name="Track" Width="42" Height="24" CornerRadius="12" Background="{DynamicResource SwitchTrack}" Padding="2">
            <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="#FFFFFF" HorizontalAlignment="Left" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBlue}" />
              <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource AccentForeground}" />
              <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Track" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Top Bar Pill Toggle Button -->
  <Style x:Key="HeaderToolButton" TargetType="ToggleButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceCard}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderHairline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Surface"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="6"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceSubtle}" />
              <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentSoft}" />
              <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBlue}" />
              <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Action Card Toggle Button (For Main Canvas Quick Actions) -->
  <Style x:Key="ActionCardToggle" TargetType="ToggleButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderHairline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="18,14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Card"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="6"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Card" Property="Background" Value="{DynamicResource SurfaceElevated}" />
              <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Window Caption Controls -->
  <Style x:Key="CaptionButton" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceSubtle}" />
              <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Modern Input TextBox -->
  <Style TargetType="TextBox">
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Background" Value="{DynamicResource BgPrimary}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderHairline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Border"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="6">
            <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBlue}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Clean Grouped Card Style -->
  <Style x:Key="GroupedCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SurfaceCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderHairline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <!-- Subtle Section Header Label -->
  <Style x:Key="SectionLabel" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="4,0,0,8" />
  </Style>


  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceElevated}" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
      <Border x:Name="Item" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource AccentSoft}" /></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource AccentBorder}" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
      <Grid>
        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource BgPrimary}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="6" /></ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" Margin="10,9,26,9" VerticalAlignment="Center" />
        <TextBlock Text="⌄" IsHitTestVisible="False" HorizontalAlignment="Right" Margin="0,0,9,0" VerticalAlignment="Center" />
        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
          <Border Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="300">
            <ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer>
          </Border>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

</Window.Resources>

<Grid x:Name="WindowSurface" Background="{DynamicResource BgPrimary}" RenderOptions.ClearTypeHint="Enabled">
  <Grid.RowDefinitions>
    <RowDefinition Height="52" />
    <RowDefinition Height="*" />
  </Grid.RowDefinitions>

  <!-- ===================================================================== -->
  <!-- 1. MINIMALIST TITLE BAR                                               -->
  <!-- ===================================================================== -->
  <Grid Grid.Row="0" Margin="24,0,12,0">
    <!-- App Brand -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Grid Width="18" Height="18" Margin="0,0,6,0" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{Binding ConnectionHint}" AutomationProperties.Name="{Binding ConnectionHint}">
        <Ellipse x:Name="ConnectionHalo" Width="18" Height="18" Fill="{DynamicResource AccentBlue}" Opacity="0" IsHitTestVisible="False"/>
        <Ellipse Width="7" Height="7" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Ellipse.Style><Style TargetType="Ellipse">
            <Setter Property="Fill" Value="{DynamicResource TextMuted}"/>
            <Style.Triggers><DataTrigger Binding="{Binding HasConnectedClients}" Value="True"><Setter Property="Fill" Value="{DynamicResource AccentBlue}"/></DataTrigger></Style.Triggers>
          </Style></Ellipse.Style>
        </Ellipse>
      </Grid>
      <TextBlock Text="{Binding AppHeading}"
                 Foreground="{DynamicResource TextSecondary}"
                 FontSize="12.5"
                 FontWeight="SemiBold"
                 VerticalAlignment="Center" />
    </StackPanel>

    <!-- Right Utilities & Window Chrome -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

      <!-- Hidden Toggle Proxy for Pair Drawer -->
      <ToggleButton x:Name="PairDrawerToggle" Visibility="Collapsed" Checked="Drawer_Checked" Unchecked="Drawer_Unchecked" />

      <!-- Activity Log Drawer Toggle (Replaces main screen clutter) -->
      <ToggleButton x:Name="ActivityDrawerToggle" Checked="Drawer_Checked" Unchecked="Drawer_Unchecked"
                    Style="{StaticResource HeaderToolButton}"
                    Margin="0,0,8,0"
                    ToolTip="View recent command logs">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0" />
          <TextBlock Text="Activity" VerticalAlignment="Center" />
        </StackPanel>
      </ToggleButton>

      <!-- More / Advanced Settings Drawer Toggle -->
      <ToggleButton x:Name="SettingsDrawerToggle" Checked="Drawer_Checked" Unchecked="Drawer_Unchecked"
                    Style="{StaticResource HeaderToolButton}"
                    Margin="0,0,14,0"
                    ToolTip="Shortcuts, Devices &amp; Network">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0" />
          <TextBlock Text="Configure" VerticalAlignment="Center" />
        </StackPanel>
      </ToggleButton>

      <!-- Window Controls -->
      <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" ToolTip="Minimize" Click="Minimize_Click" />
      <Button Style="{StaticResource CaptionButton}" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" ToolTip="Maximize or restore" Click="Maximize_Click" />
      <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" ToolTip="Hide to tray" Click="Hide_Click" />
    </StackPanel>
  </Grid>

  <!-- ===================================================================== -->
  <!-- 2. APPLE-STYLE CENTERED MAIN CANVAS (Zero Clutter, Essential Only)    -->
  <!-- ===================================================================== -->
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
    <Grid x:Name="Dashboard" MaxWidth="1100" Margin="32,8,32,28" VerticalAlignment="Center">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- A. Hero Status & Primary Toggle Card -->
      <Border x:Name="HeroCard" Grid.Row="0"
              Background="{DynamicResource SurfaceCard}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="26,22"
              Margin="0,0,0,16">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHairline}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding SharedConnectionTransport}" Value="{x:Static devices:RemoteTransport.Bluetooth}">
                <Setter Property="BorderBrush" Value="{DynamicResource BluetoothBorder}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding SharedConnectionTransport}" Value="{x:Static devices:RemoteTransport.WiFi}">
                <Setter Property="BorderBrush" Value="{DynamicResource WiFiBorder}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding SharedConnectionTransport}" Value="{x:Static devices:RemoteTransport.Tailscale}">
                <Setter Property="BorderBrush" Value="{DynamicResource TailscaleBorder}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
            <ContentControl x:Name="ConnectionStatusBadge" Content="{Binding HostStatus}" Margin="0,0,0,8"
                            ToolTip="{Binding ConnectionHint}">
              <ContentControl.Style>
                <Style TargetType="ContentControl" BasedOn="{StaticResource ConnectionBadge}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasConnectedClients}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ContentControl.Style>
            </ContentControl>

            <ItemsControl x:Name="ConnectedPhones" ItemsSource="{Binding ConnectedClients}" ToolTip="{Binding ConnectionHint}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,10">
                    <ContentControl Style="{StaticResource TransportBadge}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="SemiBold" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding NetworkSummary, Mode=OneWay}"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondary}" />
            <TextBlock Text="{Binding TailscaleConnectionSummary}" Margin="0,4,0,0" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" />
            <TextBlock Text="{Binding BluetoothConnectionSummary}" Margin="0,4,0,0" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
            <TextBlock x:Name="CommandFeedback" Text="{Binding Message, Mode=OneWay}"
                       Margin="0,5,0,0" FontSize="11.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource AccentText}" />
          </StackPanel>

          <!-- Primary Host Toggle Button -->
          <Button Grid.Column="1"
                  Content="{Binding HostButtonText}"
                  Command="{Binding ToggleHost}"
                  Style="{StaticResource PrimaryButton}"
                  VerticalAlignment="Center"
                  MinWidth="132"
                  Padding="22,12" />
        </Grid>
      </Border>

      <!-- B. Upcoming Timer Banner (Dynamic - Only visible when an action is pending) -->
      <Border x:Name="PendingCard" Grid.Row="1"
              Background="{DynamicResource AccentSoft}"
              BorderBrush="{DynamicResource AccentBorder}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="18,14"
              Margin="0,0,0,16"
              Visibility="{Binding HasPending, Converter={StaticResource BoolVisibility}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="SCHEDULED ACTION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentText}" Margin="0,0,0,2" />
            <TextBlock Text="{Binding Pending}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
          </StackPanel>
          <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelTimer}" VerticalAlignment="Center" Padding="14,7" />
        </Grid>
      </Border>

      <!-- C. Quick Actions Row (Pair Phone & Shortcuts) -->
      <Grid x:Name="QuickActions" Grid.Row="2" Margin="0,0,0,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Card 1: Pair a Phone -->
        <ToggleButton x:Name="PairAction" Grid.Column="0"
                      Style="{StaticResource ActionCardToggle}"
                      IsChecked="{Binding IsChecked, ElementName=PairDrawerToggle, Mode=TwoWay}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="6" Background="{DynamicResource AccentSoft}" Margin="0,0,12,0">
              <TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AccentBlue}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="Pair a Phone" FontSize="13.5" FontWeight="SemiBold" />
              <TextBlock Text="Scan QR or enter code" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
          </Grid>
        </ToggleButton>

        <!-- Card 2: Manage Shortcuts & Devices -->
        <ToggleButton Grid.Column="2"
                      Style="{StaticResource ActionCardToggle}"
                      IsChecked="{Binding IsChecked, ElementName=SettingsDrawerToggle, Mode=TwoWay}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="6" Background="{DynamicResource SurfaceSubtle}" Margin="0,0,12,0">
              <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="App Shortcuts" FontSize="13.5" FontWeight="SemiBold" />
              <TextBlock Text="Apps, URLs &amp; devices" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
          </Grid>
        </ToggleButton>
      </Grid>

      <!-- D. Essential Settings (Exposed Directly in Apple Inset-Grouped Style) -->
      <StackPanel x:Name="Preferences" Grid.Row="3">
        <TextBlock Text="ESSENTIAL PREFERENCES" Style="{StaticResource SectionLabel}" />

        <Border Style="{StaticResource GroupedCard}">
          <StackPanel>
            <!-- Row 1: Launch at Login -->
            <Grid Margin="18,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                <TextBlock Text="Start automatically at sign-in" FontSize="13.5" FontWeight="Medium" />
                <TextBlock Text="Launch in the tray; keep stopped connections paused" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
              </StackPanel>
              <CheckBox Grid.Column="1" Style="{StaticResource AppleToggleSwitch}" AutomationProperties.Name="Start automatically at sign-in" IsChecked="{Binding StartupEnabled}" VerticalAlignment="Center" />
            </Grid>

            <Border Height="1" Background="{DynamicResource BorderHairline}" Margin="18,0" />

            <!-- Row 2: Desktop Notifications -->
            <Grid Margin="18,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                <TextBlock Text="Show command notifications" FontSize="13.5" FontWeight="Medium" />
                <TextBlock Text="Display a subtle banner when your phone triggers an action" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
              </StackPanel>
              <CheckBox Grid.Column="1" Style="{StaticResource AppleToggleSwitch}" AutomationProperties.Name="Show command notifications" IsChecked="{Binding ShowNotifications}" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- E. Subtle Tray Hint Footer -->
      <TextBlock x:Name="TrayHint" Grid.Row="4" Grid.ColumnSpan="3"
                 Text="Closing this window keeps your remote quietly running in the system tray."
                 Foreground="{DynamicResource TextMuted}"
                 FontSize="11.5"
                 HorizontalAlignment="Center"
                 Margin="0,22,0,0" />
    </Grid>
  </ScrollViewer>

  <!-- ===================================================================== -->
  <!-- OVERLAY SHEET 1: PAIR A PHONE (Clean Modal Card)                      -->
  <!-- ===================================================================== -->
  <Grid x:Name="PairPanel" Focusable="True" KeyboardNavigation.TabNavigation="Cycle" Grid.Row="1" Visibility="Collapsed" presentation:DrawerTransition.IsOpen="{Binding IsChecked, ElementName=PairDrawerToggle}">
    <Border Background="{DynamicResource DrawerBackdrop}" MouseLeftButtonDown="Backdrop_Click" />

    <Border Width="390"
            HorizontalAlignment="Right"
            Background="{DynamicResource SurfaceCard}"
            BorderBrush="{DynamicResource BorderHairline}"
            BorderThickness="1,0,0,0"
            CornerRadius="16,0,0,16"
            Padding="28">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Grid Margin="0,0,0,18">
            <TextBlock Text="Pair a Phone" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ToggleButton IsChecked="{Binding IsChecked, ElementName=PairDrawerToggle, Mode=TwoWay}"
                          AutomationProperties.Name="Close panel" Content="&#xE8BB;"
                          FontFamily="Segoe MDL2 Assets"
                          FontSize="10"
                          Width="30"
                          Height="30"
                          Padding="0"
                          HorizontalAlignment="Right"
                          Style="{StaticResource HeaderToolButton}" />
          </Grid>

          <TextBlock Text="{Binding PairingHint}" Foreground="{DynamicResource TextSecondary}" FontSize="13" LineHeight="19" Margin="0,0,0,20" />

          <!-- Crisp QR Container -->
          <Border Background="White"
                  CornerRadius="16"
                  Padding="12"
                  Margin="0,0,0,14"
                  HorizontalAlignment="Center"
                  Visibility="{Binding HasPairingQr, Converter={StaticResource BoolVisibility}}">
            <Image Source="{Binding PairingQrImage}"
                   Width="200"
                   Height="200"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                   AutomationProperties.Name="Scan to pair with TapMyPC" />
          </Border>

          <TextBlock Text="{Binding PairingExpiry}"
                     Foreground="{DynamicResource TextSecondary}"
                     FontSize="12"
                     HorizontalAlignment="Center"
                     Margin="0,0,0,18" />

          <Button Content="{Binding PairingButtonText}"
                  Command="{Binding OpenPairing}"
                  IsEnabled="{Binding IsHosting}"
                  Style="{StaticResource PrimaryButton}"
                  HorizontalAlignment="Stretch"
                  Margin="0,0,0,22" />

          <TextBlock Text="{Binding Message}" Foreground="{DynamicResource AccentText}" FontSize="12" Margin="0,0,0,16" />
          <!-- Manual Code Fallback Hidden Inside Expander -->
          <Expander Header="Manual browser link &amp; code" Foreground="{DynamicResource TextSecondary}" FontSize="12.5">
            <Border Style="{StaticResource GroupedCard}" Padding="16" Margin="0,10,0,0">
              <StackPanel>
                <TextBlock Text="PAIRING CODE" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding PairingCode}"
                           FontSize="24"
                           FontFamily="Consolas"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AccentText}"
                           Margin="0,0,0,14" />

                <TextBlock Text="LOCAL REMOTE URL" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox Text="{Binding RemoteUrl, Mode=OneWay}" IsReadOnly="True" FontSize="12" />
                  <Button Grid.Column="1" Content="Copy" Command="{Binding CopyUrl}" IsEnabled="{Binding IsHosting}" Margin="8,0,0,0" />
                </Grid>
              </StackPanel>
            </Border>
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>

  <!-- ===================================================================== -->
  <!-- OVERLAY SHEET 2: ACTIVITY LOGS (Hidden by default, on-demand only)    -->
  <!-- ===================================================================== -->
  <Grid x:Name="ActivityPanel" Focusable="True" KeyboardNavigation.TabNavigation="Cycle" Grid.Row="1" Visibility="Collapsed" presentation:DrawerTransition.IsOpen="{Binding IsChecked, ElementName=ActivityDrawerToggle}">
    <Border Background="{DynamicResource DrawerBackdrop}" MouseLeftButtonDown="Backdrop_Click" />

    <Border Width="400"
            HorizontalAlignment="Right"
            Background="{DynamicResource SurfaceCard}"
            BorderBrush="{DynamicResource BorderHairline}"
            BorderThickness="1,0,0,0"
            CornerRadius="16,0,0,16"
            Padding="26">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
          <StackPanel>
            <TextBlock Text="Activity Log" FontSize="19" FontWeight="SemiBold" />
            <TextBlock Text="Real-time history of remote commands" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
          </StackPanel>
          <ToggleButton IsChecked="{Binding IsChecked, ElementName=ActivityDrawerToggle, Mode=TwoWay}"
                        AutomationProperties.Name="Close panel" Content="&#xE8BB;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Width="30"
                        Height="30"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Style="{StaticResource HeaderToolButton}" />
        </Grid>

        <!-- Empty State -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.7">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Activity.Count}" Value="0">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,10" />
          <TextBlock Text="No recent commands" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
          <TextBlock Text="Commands triggered from your phone will be logged here." FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Log Items -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
          <ItemsControl ItemsSource="{Binding Activity}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource SurfaceElevated}"
                        BorderBrush="{DynamicResource BorderHairline}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,11"
                        Margin="0,0,0,8">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Message}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Background="{DynamicResource SurfaceSubtle}" CornerRadius="6" Padding="8,3" VerticalAlignment="Center" Margin="8,0,0,0">
                      <TextBlock Text="{Binding Phase}" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" />
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>

  <!-- ===================================================================== -->
  <!-- OVERLAY SHEET 3: SHORTCUTS, DEVICES & ADVANCED NETWORK                -->
  <!-- ===================================================================== -->
  <Grid x:Name="SettingsPanel" Focusable="True" KeyboardNavigation.TabNavigation="Cycle" Grid.Row="1" Visibility="Collapsed" presentation:DrawerTransition.IsOpen="{Binding IsChecked, ElementName=SettingsDrawerToggle}">
    <Border Background="{DynamicResource DrawerBackdrop}" MouseLeftButtonDown="Backdrop_Click" />

    <Border Width="450"
            HorizontalAlignment="Right"
            Background="{DynamicResource SurfaceCard}"
            BorderBrush="{DynamicResource BorderHairline}"
            BorderThickness="1,0,0,0"
            CornerRadius="16,0,0,16"
            Padding="28">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel>
          <!-- Drawer Header -->
          <Grid Margin="0,0,0,22">
            <TextBlock Text="Configure" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ToggleButton IsChecked="{Binding IsChecked, ElementName=SettingsDrawerToggle, Mode=TwoWay}"
                          AutomationProperties.Name="Close panel" Content="&#xE8BB;"
                          FontFamily="Segoe MDL2 Assets"
                          FontSize="10"
                          Width="30"
                          Height="30"
                          Padding="0"
                          HorizontalAlignment="Right"
                          Style="{StaticResource HeaderToolButton}" />
          </Grid>

          <TextBlock Text="{Binding Message}" Foreground="{DynamicResource AccentText}" FontSize="12" Margin="0,0,0,16" />
          <!-- Paired Devices -->
          <TextBlock Text="AUTHORIZED PHONES" Style="{StaticResource SectionLabel}" />
          <Border Style="{StaticResource GroupedCard}" Padding="16" Margin="0,0,0,22">
            <StackPanel>
              <ListBox ItemsSource="{Binding Devices}"
                       SelectedItem="{Binding SelectedDevice}"
                       DisplayMemberPath="Name"
                       Background="{DynamicResource BgPrimary}"
                       Foreground="{DynamicResource TextPrimary}"
                       BorderBrush="{DynamicResource BorderHairline}"
                       MinHeight="56"
                       MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ListViewportHeight}}" />
              <TextBlock Text="Phone name" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,12,0,6" />
              <TextBox Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" AutomationProperties.Name="Paired phone name" />
              <Button Content="Save phone name" Command="{Binding RenameDevice}" HorizontalAlignment="Left" Padding="12,6" FontSize="12" Margin="0,8,0,0" />
              <Button Content="Revoke selected access" Command="{Binding RevokeDevice}" HorizontalAlignment="Left" Padding="12,6" FontSize="12" Margin="0,10,0,0" />
            </StackPanel>
          </Border>

          <TextBlock Text="REMOTE ACCESS" Style="{StaticResource SectionLabel}" />
          <Border Style="{StaticResource GroupedCard}" Padding="16" Margin="0,0,0,22">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Allow access through Tailscale" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,12,0" />
                <CheckBox Grid.Column="1" Style="{StaticResource AppleToggleSwitch}"
                          IsChecked="{Binding TailscaleEnabled, Mode=OneWay}"
                          Command="{Binding ToggleTailscale}" IsEnabled="{Binding CanResetIdentity}"
                          AutomationProperties.Name="Allow access through Tailscale" />
              </Grid>
              <TextBlock Text="Local network access stays available. Install and connect Tailscale on both devices. Your phone learns this address after connecting."
                         FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,10,0,8" />
              <TextBlock Text="{Binding TailscaleConnectionSummary}" FontSize="11.5" Foreground="{DynamicResource AccentText}" />
              <TextBox Text="{Binding TailscaleUrl, Mode=OneWay}" IsReadOnly="True" FontSize="11.5"
                       AutomationProperties.Name="Tailscale address" Margin="0,8,0,0" Visibility="{Binding HasTailscaleAddress, Converter={StaticResource BoolVisibility}}" />
            </StackPanel>
          </Border>

          <TextBlock Text="HARDWARE MONITORING" Style="{StaticResource SectionLabel}" />
          <Border Style="{StaticResource GroupedCard}" Padding="16" Margin="0,0,0,22">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="PC Stats Tray" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,12,0" />
                <TextBlock Grid.Column="1" Text="{Binding MonitoringStatus}" FontSize="12"
                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Text="{Binding MonitoringDetails}" FontSize="11.5"
                         Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Style.Triggers>
                      <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Border>

          <!-- App & Website Shortcuts -->
          <TextBlock Text="QUICK LAUNCH SHORTCUTS" Style="{StaticResource SectionLabel}" />
          <Border Style="{StaticResource GroupedCard}" Padding="16" Margin="0,0,0,22" DataContext="{Binding ShortcutSettings}">
            <StackPanel>
              <TextBlock Text="Approve apps or websites your phone is allowed to open." Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,12" />

              <TextBlock Text="Shortcut name" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />
              <TextBox AutomationProperties.Name="Shortcut name" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" ToolTip="Shortcut label (e.g. Spotify)" Margin="0,0,0,8" />
              <TextBlock Text="Website address (http:// or https://)" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox AutomationProperties.Name="Website address" Text="{Binding WebsiteUrl, UpdateSourceTrigger=PropertyChanged}" MaxLength="2048" ToolTip="https://..." />
                <Button Grid.Column="1" Content="Add URL" Command="{Binding AddWebsite}" Margin="8,0,0,0" />
              </Grid>

              <Button Content="Choose local app or .lnk…" Command="{Binding AddApp}" HorizontalAlignment="Stretch" Margin="0,0,0,12" />

              <ListBox ItemsSource="{Binding Items}"
                       SelectedItem="{Binding Selected}"
                       Background="{DynamicResource BgPrimary}"
                       Foreground="{DynamicResource TextPrimary}"
                       BorderBrush="{DynamicResource BorderHairline}"
                       MinHeight="64"
                       MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ListViewportHeight}}"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="4">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" />
                      <TextBlock Text="{Binding Target}" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <StackPanel Margin="0,10,0,0">
                <Button Content="Remove selected" Command="{Binding Remove}" HorizontalAlignment="Left" Padding="12,6" FontSize="12" />
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" Margin="0,10,0,0" />
              </StackPanel>
            </StackPanel>
          </Border>

          <StackPanel DataContext="{Binding Appearance}" Margin="0,0,0,22">
            <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource GroupedCard}" Padding="16">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Theme" FontSize="12" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding Theme}" AutomationProperties.Name="Theme" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Accent color" FontSize="12" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding AccentChoices}" SelectedItem="{Binding Accent}" AutomationProperties.Name="Accent color" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="{Binding Status}" FontSize="11.5" Margin="0,8,0,0" Foreground="{DynamicResource AccentText}"/>
              </StackPanel>
            </Border>
          </StackPanel>
          <!-- Advanced network and security -->
          <Expander Header="Advanced Network &amp; Security" Foreground="{DynamicResource TextSecondary}" FontSize="12.5">
            <Border Style="{StaticResource GroupedCard}" Padding="16" Margin="0,10,0,0">
              <StackPanel>
                <TextBlock Text="Local network adapter and shared TapMyPC port. Keep Automatic for normal use. Tailscale is enabled separately above; stop connections before changing these advanced settings." Foreground="{DynamicResource TextMuted}" FontSize="11.5" Margin="0,0,0,12" />
                <Grid Margin="0,0,0,16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ComboBox AutomationProperties.Name="Network adapter" ToolTip="{Binding SelectedItem.Label, RelativeSource={RelativeSource Self}}" ItemsSource="{Binding NetworkChoices}"
                            DisplayMemberPath="Label"
                            SelectedValuePath="Address"
                            SelectedValue="{Binding Address}"
                            IsEnabled="{Binding CanEditConnection}"
                            Padding="8" />
                  <TextBox Grid.Column="1" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConnection}" Margin="8,0,0,0" ToolTip="Port" AutomationProperties.Name="Port" />
                  <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshNetwork}" IsEnabled="{Binding CanEditConnection}" Margin="8,0,0,0" Padding="10,8" />
                </Grid>

                <TextBlock Text="CERTIFICATE FINGERPRINT (SHA-256)" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                <TextBox Text="{Binding Fingerprint, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Certificate fingerprint" FontFamily="Consolas" FontSize="11" Margin="0,0,0,10" />
                <TextBlock Text="{Binding CertificateSummary}" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10" />
                <Button Content="Export public certificate" Command="{Binding ExportCertificate}" HorizontalAlignment="Left" Padding="12,6" FontSize="12" />
                <Button Content="Reset connection identity…" Command="{Binding RequestIdentityReset}" IsEnabled="{Binding CanResetIdentity}" HorizontalAlignment="Left" Padding="12,6" FontSize="12" Margin="0,12,0,0" />
                <StackPanel Visibility="{Binding IdentityResetRequested, Converter={StaticResource BoolVisibility}}" Margin="0,12,0,0">
                  <TextBlock Text="Reset this PC’s connection identity? All phones will lose access and must pair again with a new QR. Pending timers continue." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                  <WrapPanel Margin="0,10,0,0">
                    <Button Content="Reset and revoke all phones" Command="{Binding ConfirmIdentityReset}" IsEnabled="{Binding CanResetIdentity}" Padding="10,6" Margin="0,0,8,8" />
                    <Button Content="Keep current identity" Command="{Binding CancelIdentityReset}" Padding="10,6" Margin="0,0,0,8" />
                  </WrapPanel>
                </StackPanel>
              </StackPanel>
            </Border>
          </Expander>

          <TextBlock Text="No firewall or system certificate-trust settings are modified automatically."
                     Foreground="{DynamicResource TextMuted}"
                     FontSize="11"
                     Margin="4,18,0,0" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>

</Grid>

</Window>
