<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>TapMyPC</AssemblyName>
    <RootNamespace>TapMyPC.Desktop</RootNamespace>
    <Product>TapMyPC</Product>
    <Title>TapMyPC</Title>
    <Description>Your PC, a tap away.</Description>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF owns startup and DPI awareness; WinForms is used only for NotifyIcon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/TapMyPC.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <ProjectReference Include="../TapMyPC.Core/TapMyPC.Core.csproj" />
    <ProjectReference Include="../TapMyPC.Windows/TapMyPC.Windows.csproj" />
    <ProjectReference Include="../TapMyPC.Api/TapMyPC.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.1" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets/Fonts/*.ttf" />
    <Resource Include="Assets/Icons/Tailscale.png" />
    <Resource Include="Assets/TapMyPC.ico" />
    <EmbeddedResource Include="Assets/Fonts/Inter-OFL.txt" LogicalName="TapMyPC.Licenses.Inter.txt" />
    <EmbeddedResource Include="$(PkgQRCoder)/LICENSE.txt" LogicalName="TapMyPC.Licenses.QRCoder.txt" />
    <EmbeddedResource Include="../TapMyPC.Windows/ThirdParty/*-LICENSE.txt" LogicalName="TapMyPC.Licenses.%(Filename)%(Extension)" />
    <None Include="$(PkgQRCoder)/LICENSE.txt" CopyToPublishDirectory="PreserveNewest" TargetPath="ThirdParty/QRCoder-LICENSE.txt" />
    <None Update="Assets/Fonts/Inter-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="Inter-OFL.txt" />
  </ItemGroup>
</Project>
